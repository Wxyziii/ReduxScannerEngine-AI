{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wxyziii/ReduxScannerEngine-AI/schemas/planner_schema.json",
  "type": "object",
  "required": ["schemaVersion", "prompt", "tasks"],
  "properties": {
    "schemaVersion": {"const": "redux-maker.planner.v1"},
